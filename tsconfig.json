{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "outDir": "./ts_to_js_files",
    "rootDir": "./ticket_drafting_mods/",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "./ticket_drafting_mods/*.ts"
  ],
  "exclude": [
    "node_modules",
    "ts_to_js_files"
  ]
}